---
import NTLink from "./util/NTLink.astro";

const year = new Date().getFullYear();

interface FooterLink {
  label: string;
  href: string;
}

interface FooterSection {
  title: string;
  links: FooterLink[];
}

const sections: FooterSection[] = [
  {
    title: "Organization",
    links: [
      { label: "About us", href: "https://github.com/drift-language" },
      { label: "Our newsroom", href: "https://news.gotthard.driftlang.dev" },
      // { label: "Contact us", href: "https://gotthard.driftlang.dev" },
    ],
  },
  {
    title: "Community",
    links: [
      { label: "GitHub Organization", href: "https://github.com/drift-language" },
      // { label: "Discord Community", href: "https://gotthard.driftlang.dev" },
      // { label: "X (formerly Twitter)", href: "https://gotthard.driftlang.dev" },
      // { label: "Mastodon", href: "https://gotthard.driftlang.dev" },
    ],
  },
  {
    title: "Project",
    links: [
      { label: "Introducing Gotthard", href: "https://news.driftlang.dev/drift-gotthard/" },
      { label: "Contributing", href: "https://github.com/drift-language" },
      { label: "Report an Issue", href: "https://github.com/drift-language" },
      { label: "License", href: "https://github.com/drift-language/drift/blob/main/LICENSE.md" },
    ],
  },
  {
    title: "Language",
    links: [
      // { label: "Documentation", href: "https://docs.driftlang.dev" },
      // { label: "Changelog", href: "https://docs.driftlang.dev" },
      { label: "Roadmap", href: "https://github.com/orgs/drift-language/projects/1/views/1" },
    ],
  },
];
---


<footer class:list={[
  "border-t border-(--drift-border)",
  "text-sm text-(--drift-text-faint)",
  "relative z-10 bg-(--drift-bg)",
]}>

<div class:list={[
  "max-w-300 mx-auto",
  "flex flex-col lg:flex-row lg:justify-between gap-10",
  "px-8 py-6",
]}>

  <div class:list={[
    "flex flex-col gap-y-7",
    "text-justify lg:max-w-96 shrink-0",
  ]}>

    <p>Drift © 2025-{year}</p>

    <p>
      Drift and all associated software, documentation, and assets are
      made available as open-source under the Apache License, Version
      2.0. Redistribution and use in source or binary forms, with or
      without modification, are permitted provided that copyright and
      license notices are preserved. The name "Drift" and its release
      codenames, including "Gotthard", may not be used to endorse or
      promote derivative works without prior written permission. <br />
      © {year} <NTLink href="https://github.com/belicfr">Jonathan</NTLink> &
      Drift Approved Contributors.
    </p>

    <p>
      Drift is provided "as is" without warranty of any kind. The authors
      and contributors shall not be liable for any damages arising from the
      use of this software, including but not limited to data loss, system
      failure, or any other direct or indirect damages.
    </p>

    <p>
      Drift may incorporate third-party open-source components, each governed
      by their respective licenses. A full list of dependencies and their
      licenses is available in the project repository.
    </p>

    <p>
      This software is administered, monitored and designed in France, but its
      contributors come from all around the world. Any disputes arising from its
      use shall be governed by French law.
    </p>
  </div>

  <div class:list={[
    "grid grid-cols-1 lg:grid-cols-2 gap-10",
  ]}>

    {sections.map((section) => (
      <section class="flex flex-col gap-y-1">
        <h6 class="font-semibold">{section.title}</h6>
        {section.links.map((link) => (
          <NTLink href={link.href}>{link.label}</NTLink>
        ))}
      </section>
    ))}

    <section>
      <p>
        Designed in France
      </p>
    </section>
  </div>

</div>
</footer>