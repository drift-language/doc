<style>
  /* Keyframes — not expressible as Tailwind utilities */
  @keyframes blobDrift1 {
    0%, 100% { transform: translate(0,0) scale(1); }
    50%       { transform: translate(-28px,44px) scale(1.1); }
  }
  @keyframes blobDrift2 {
    0%, 100% { transform: translate(0,0) scale(1); }
    50%       { transform: translate(36px,-24px) scale(0.93); }
  }
  @keyframes blobDrift3 {
    0%, 100% { transform: translate(0,0) scale(1); }
    40%       { transform: translate(-18px,-36px) scale(1.07); }
  }

  @keyframes drawPath {
    to { clip-path: inset(0 0% 0 0); }
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes scrollHint {
    0%   { opacity: 0; transform: translateY(-6px); }
    50%  { opacity: 1; }
    100% { opacity: 0; transform: translateY(8px); }
  }

  /* Gotthard SVG path draw animation */
  .gotthard-path {
    clip-path: inset(0 100% 0 0);
    animation: drawPath 1.2s cubic-bezier(.4, 0, .2, 1) forwards;
  }

  /* JS-toggled reveal states */
  .js-reveal {
    opacity: 0;
    transform: translateY(36px);
    transition: opacity 0.95s cubic-bezier(.25,.1,.25,1), transform 0.95s cubic-bezier(.25,.1,.25,1);
  }

  .js-reveal.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* JS-toggled dot active state */
  .featDotActive {
    background-color: #2997FF !important;
    transform: scale(1.4);
  }
</style>

<script>
  // ── Feature scroll ────────────────────────────────────────
  const featScroll = document.getElementById('feat-scroll');
  const layers = [...document.querySelectorAll('[data-feat-layer]')] as HTMLElement[];
  const fill = document.getElementById('feat-progress-fill') as HTMLElement;
  const dots = [...document.querySelectorAll('[data-dot]')] as HTMLElement[];
  const N = layers.length;

  function clamp(v: number, lo: number, hi: number) { return Math.max(lo, Math.min(hi, v)); }

  function multiMap(v: number, xs: number[], ys: number[]) {
    if (v <= xs[0]) return ys[0];
    if (v >= xs[xs.length - 1]) return ys[ys.length - 1];
    for (let i = 0; i < xs.length - 1; i++) {
      if (v <= xs[i + 1]) {
        const t = (v - xs[i]) / (xs[i + 1] - xs[i]);
        return ys[i] + (ys[i + 1] - ys[i]) * t;
      }
    }
    return ys[ys.length - 1];
  }

  // Mirrors Framer Motion useTransform breakpoints from the original page
  const TRANSITIONS = [
    { opX: [0, 0.20, 0.25],           opY: [1, 1, 0],    yX: [0.20, 0.25],           yY: [0, -30]      },
    { opX: [0.20, 0.25, 0.45, 0.50],  opY: [0, 1, 1, 0], yX: [0.20, 0.25, 0.45, 0.50], yY: [30, 0, 0, -30] },
    { opX: [0.45, 0.50, 0.70, 0.75],  opY: [0, 1, 1, 0], yX: [0.45, 0.50, 0.70, 0.75], yY: [30, 0, 0, -30] },
    { opX: [0.70, 0.75, 1.0],          opY: [0, 1, 1],    yX: [0.70, 0.75],           yY: [30, 0]        },
  ];

  function onScroll() {
    if (!featScroll) return;
    const rect = featScroll.getBoundingClientRect();
    const scrollable = rect.height - window.innerHeight;
    const progress = clamp(-rect.top / scrollable, 0, 1);

    fill.style.width = (progress * 100) + '%';

    const activeIdx = Math.min(N - 1, Math.floor(progress * N));
    dots.forEach((dot, i) => {
      dot.classList.toggle('featDotActive', i === activeIdx);
    });

    layers.forEach((layer, i) => {
      const t = TRANSITIONS[i];
      const op = multiMap(progress, t.opX, t.opY);
      const y  = multiMap(progress, t.yX, t.yY);
      layer.style.opacity = String(op);
      layer.style.transform = `translateY(${y}px)`;
    });
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // ── Intersection Observer reveals ─────────────────────────
  const observer = new IntersectionObserver(
    (entries) => entries.forEach(e => {
      if (e.isIntersecting) {
        (e.target as HTMLElement).classList.add('revealed');
        observer.unobserve(e.target);
      }
    }),
    { rootMargin: '-100px' }
  );
  document.querySelectorAll('.js-reveal').forEach(el => observer.observe(el));
</script>
