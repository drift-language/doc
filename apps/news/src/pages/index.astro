---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('articles');
const sorted = all.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = sorted.find(a => a.data.featured) ?? sorted[0];
const rest = featured ? sorted.filter(a => a.slug !== featured.slug) : [];

function fmt(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Base title="Newsroom" current="Newsroom">
  {featured && (
    <a
      class:list={[
        'group block relative w-full min-h-[68vh]',
        'no-underline hover:opacity-100 overflow-hidden',
      ]}
      href={`/${featured.slug}`}
      style={`background: ${featured.data.gradient}`}
    >

      <div class="absolute inset-0 bg-[linear-gradient(to_top,rgba(6,8,14,0.92)_0%,rgba(6,8,14,0.2)_70%)]" />

      <div class:list={[
        'absolute bottom-0 left-0 right-0 mx-auto',
        'px-8 py-12 max-[900px]:py-8 max-w-300',
        'flex flex-col gap-[0.85rem]',
      ]}>

        <span class:list={[
          'inline-block w-fit',
          'text-[0.68rem] font-semibold tracking-widest uppercase',
          'text-(--drift-accent-hi) border border-(--drift-accent-lo) rounded-full',
          'py-[0.25em] px-[0.75em]',
        ]}>

          {featured.data.category}
        </span>

        <h1 class:list={[
          'text-[clamp(2rem,4.5vw,3.8rem)] font-bold tracking-[-0.045em] leading-[1.06]',
          'text-[#f5f5f7] max-w-175',
          'transition-opacity duration-200 group-hover:opacity-85',
        ]}>

          {featured.data.title}
        </h1>

        <p class:list={[
          'text-[clamp(0.9rem,1.4vw,1.05rem)] leading-[1.6] max-w-145',
          'text-[rgba(219,232,241,0.7)]',
        ]}>

          {featured.data.excerpt}
        </p>

        <p class="text-[0.78rem] text-[rgba(219,232,241,0.45)] tracking-[0.02em]">
          {fmt(featured.data.date)}
        </p>
      </div>
    </a>
  )}

  <section class:list={[
    'pt-16 px-12 pb-24 max-[600px]:pt-12 max-[600px]:px-6 max-[600px]:pb-16',
    'max-w-300 mx-auto',
  ]}>

    {!!rest.length && (
      <h2 class:list={[
        'text-4xl font-semibold',
        'text-(--drift-text) mb-8',
      ]}>

        Latest
      </h2>
    )}

    <div class="grid grid-cols-3 gap-6 max-[900px]:grid-cols-2 max-[600px]:grid-cols-1">
      {rest.map(article => (
        <a
          class:list={[
            'flex flex-col no-underline hover:opacity-100',
            'border border-(--drift-border) rounded-(--drift-radius-lg)',
            'overflow-hidden bg-(--drift-bg-subtle)',
            'transition-[border-color,transform] duration-200 ease-in-out',
            'hover:border-(--drift-accent-lo) hover:-translate-y-0.5',
          ]}
          href={`/${article.slug}`}
        >

          <div class="h-40 w-full shrink-0" style={`background: ${article.data.gradient}`} />

          <div class="p-6 flex flex-col gap-[0.6rem] flex-1">
            <span class:list={[
              'inline-block w-fit',
              'text-[0.62rem] font-semibold tracking-widest uppercase',
              'text-(--drift-accent-hi) border border-(--drift-accent-lo) rounded-full',
              'py-[0.25em] px-[0.75em]',
            ]}>

              {article.data.category}
            </span>
            <h3 class:list={[
              'text-[1.05rem] font-bold tracking-[-0.02em] leading-[1.3]',
              'text-(--drift-text)',
            ]}>

              {article.data.title}
            </h3>
            <p class="text-[0.855rem] text-(--drift-text-muted) leading-[1.6] flex-1">
              {article.data.excerpt}
            </p>
            <p class="text-xs text-(--drift-text-faint) mt-1">
              {fmt(article.data.date)}
            </p>
          </div>
        </a>
      ))}

      {!all.length &&
        <p>Nothing to read, please retry later.</p>}
    </div>
  </section>
</Base>

<style is:global>
  main { padding: 0 !important; }
</style>