---
import '@drift/ui/tokens';
import Navbar from '@drift/ui/Navbar';
import Footer from '@drift/ui/Footer';

export interface Props {
  title: string;
  date: Date;
  category: string;
  author: string;
  gradient: string;
}

const { title, date, category, author, gradient } = Astro.props;

const formatted = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<!doctype html>
<html lang="en">
<head>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{title} — Drift Newsroom</title>
</head>
<body class:list={[
  "bg-(--drift-bg)",
  "text-(--drift-text) font-(--drift-font-sans)",
  "min-h-screen"
]}>

  <Navbar current="Newsroom" section="Newsroom" />

  <div
    class:list={[
      "relative w-full min-h-[52vh]",
      "flex items-end",
      "after:content-[''] after:absolute after:inset-0",
      "after:bg-[linear-gradient(to_top,rgba(6,8,14,0.85)_0%,transparent_60%)]",
    ]}
    style={`background: ${gradient}`}
  >

    <div class:list={[
      "relative z-10 max-w-300 w-full mx-auto py-12 px-8",
      "flex flex-col gap-3",
    ]}>

      <span class:list={[
        "text-[0.7rem] font-semibold tracking-[0.12em] uppercase text-(--drift-accent-hi)"
      ]}>

        {category}
      </span>

      <h1 class:list={[
        "text-[clamp(2rem,5vw,3.5rem)] font-bold tracking-[-0.04em] leading-[1.08] text-[#f5f5f7]",
        "max-w-190"
      ]}>

        {title}
      </h1>

      <p class:list={[
        "text-[0.82rem] text-[rgba(219,232,241,0.55)]"
      ]}>

        {formatted} &nbsp;·&nbsp; {author}
      </p>
    </div>
  </div>

  <main class:list={["max-w-300 mx-auto px-8 pt-16 pb-24"]}>
    <article class:list={["prose max-w-170"]}>
      <slot />
    </article>
  </main>

  <Footer />
</body>
</html>